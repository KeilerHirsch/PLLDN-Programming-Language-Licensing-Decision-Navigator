{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "files": {
    "includes": [
      "**",
      "!.build",
      "!node_modules",
      "!reports",
      "!package-lock.json",
      "!LICENSE",
      "!LICENSES",
      "!knowledge/reviewed",
      "!src/validation/generated/validators.cjs"
    ]
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
