{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release",
    "target_commit_sha",
    "assets",
    "release_notes"
  ],
  "properties": {
    "schema_version": { "const": "0.1" },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "tag", "title", "prerelease"],
      "properties": {
        "version": { "type": "string" },
        "tag": { "type": "string" },
        "title": { "type": "string" },
        "prerelease": { "const": true }
      }
    },
    "target_commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "assets": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256"],
        "properties": {
          "name": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "release_notes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "text"],
      "properties": {
        "path": { "const": "release/v0.0.1-beta.1/release-notes.md" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "text": { "type": "string", "minLength": 1 }
      }
    }
  }
}
