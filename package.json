{
  "name": "plldn",
  "version": "0.0.1-beta.1",
  "private": true,
  "description": "Programming Language & Licensing Decision Navigator",
  "license": "EUPL-1.2",
  "type": "module",
  "engines": {
    "node": "24.15.0",
    "npm": "11.12.1"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test tests/*.test.ts",
    "test:browser": "node tools/browser-smoke.ts",
    "audit:preview-provenance": "node tools/preview-provenance-audit.ts",
    "audit:language-bands": "node tools/audit-language-bands.ts",
    "audit:language-observations": "node tools/audit-language-observations.ts",
    "catalog:import": "node tools/import-identity-sources.ts",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/**/*.ts --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80 tests/*.test.ts",
    "verify": "node tools/verify.ts",
    "evidence": "node tools/evidence.ts",
    "check:repository": "node tools/repository.ts",
    "build:browser": "node tools/build-browser.ts",
    "build:pages": "node tools/build-pages.ts",
    "build:release": "node tools/build-release.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "jsonc-parser": "3.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.1",
    "esbuild-wasm": "0.28.2",
    "typescript": "7.0.2"
  }
}
