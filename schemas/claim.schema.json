{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plldn.invalid/schemas/claim.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{1,127}$"
    },
    "entity_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{1,127}$"
    },
    "dimension_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{1,127}$"
    },
    "value": {
      "$ref": "common.schema.json#/$defs/value"
    },
    "state": {
      "enum": ["TRUE", "FALSE", "CONDITIONAL", "UNKNOWN", "NOT_APPLICABLE"]
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dimension_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{1,127}$"
          },
          "operator": {
            "enum": ["EQ", "NEQ", "IN", "GTE", "LTE"]
          },
          "value": {
            "$ref": "common.schema.json#/$defs/value"
          }
        },
        "required": ["dimension_id", "operator", "value"],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10000,
      "uniqueItems": true
    },
    "scope": {
      "$ref": "common.schema.json#/$defs/scope"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._-]{1,127}$"
      },
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "world_freshness_class": {
      "enum": ["normative", "version-bound", "volatile"]
    },
    "review_status": {
      "enum": [
        "Reviewed",
        "Partial",
        "Preview",
        "Review due",
        "Unknown",
        "Unsupported"
      ]
    },
    "test_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._-]{1,127}$"
      },
      "minItems": 0,
      "maxItems": 10000,
      "uniqueItems": true
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._-]{1,127}$"
      },
      "minItems": 0,
      "maxItems": 10000,
      "uniqueItems": true
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "claim_id",
    "entity_id",
    "dimension_id",
    "state",
    "conditions",
    "scope",
    "source_ids",
    "verified_at",
    "world_freshness_class",
    "review_status",
    "test_refs",
    "supersedes"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": ["UNKNOWN", "NOT_APPLICABLE"]
          }
        },
        "required": ["state"]
      },
      "then": {
        "not": {
          "required": ["value"],
          "properties": {
            "value": {}
          }
        }
      },
      "else": {
        "required": ["value"],
        "properties": {
          "value": {}
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "CONDITIONAL"
          }
        },
        "required": ["state"]
      },
      "then": {
        "required": ["conditions"],
        "properties": {
          "conditions": {
            "minItems": 1,
            "type": "array"
          }
        }
      }
    }
  ]
}
