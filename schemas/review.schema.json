{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plldn.invalid/schemas/review.schema.json",
  "type": "object",
  "properties": {
    "schema_version": { "const": "0.1" },
    "review_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{1,127}$"
    },
    "candidate_manifest_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewer": {
      "type": "object",
      "properties": {
        "kind": { "const": "human" },
        "identity": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "required": ["kind", "identity"],
      "additionalProperties": false
    },
    "reviewed_at": { "type": "string", "format": "date-time" },
    "decision": { "const": "APPROVE" },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "properties": {
          "assertion_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{1,127}$"
          },
          "test_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9._-]{1,127}$"
            }
          }
        },
        "required": ["assertion_id", "test_refs"],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "review_id",
    "candidate_manifest_sha256",
    "reviewer",
    "reviewed_at",
    "decision",
    "assertions"
  ],
  "additionalProperties": false
}
