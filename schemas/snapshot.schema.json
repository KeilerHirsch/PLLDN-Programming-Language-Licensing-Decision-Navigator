{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plldn.invalid/schemas/snapshot.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "knowledge_snapshot": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{1,127}$"
    },
    "rules_snapshot": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{1,127}$"
    },
    "schema_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[a-z0-9_-]+(?:/[a-z0-9_-]+)*\\.json$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": ["path", "sha256"],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "knowledge_snapshot",
    "rules_snapshot",
    "schema_sha256",
    "documents"
  ],
  "additionalProperties": false
}
