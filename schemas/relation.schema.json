{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plldn.invalid/schemas/relation.schema.json",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "relation_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{1,127}$"
    },
    "relation_type": {
      "enum": ["capability-dependency", "interaction", "license-combination"]
    },
    "from_entity": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{1,127}$"
    },
    "to_entity": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{1,127}$"
    },
    "direction": {
      "const": "from-to"
    },
    "scenario": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "artifact_class": {
      "enum": [
        "outgoing-code",
        "incoming-code",
        "contribution",
        "notice",
        "docs-media",
        "dataset-database",
        "font-asset",
        "model-weight-data",
        "hardware",
        "trademark-branding",
        "release-provenance"
      ]
    },
    "boundary_type": {
      "enum": [
        "native-abi-ffi",
        "process",
        "network-api",
        "trust-security",
        "persistence-schema",
        "deployment",
        "ownership-maintenance"
      ]
    },
    "state": {
      "enum": ["TRUE", "FALSE", "CONDITIONAL", "UNKNOWN", "NOT_APPLICABLE"]
    },
    "value": {
      "$ref": "common.schema.json#/$defs/value"
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dimension_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9._-]{1,127}$"
          },
          "operator": {
            "enum": ["EQ", "NEQ", "IN", "GTE", "LTE"]
          },
          "value": {
            "$ref": "common.schema.json#/$defs/value"
          }
        },
        "required": ["dimension_id", "operator", "value"],
        "additionalProperties": false
      },
      "minItems": 0,
      "maxItems": 10000,
      "uniqueItems": true
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._-]{1,127}$"
      },
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "world_freshness_class": {
      "enum": ["normative", "version-bound", "volatile"]
    },
    "review_status": {
      "enum": [
        "Reviewed",
        "Partial",
        "Preview",
        "Review due",
        "Unknown",
        "Unsupported"
      ]
    },
    "test_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._-]{1,127}$"
      },
      "minItems": 0,
      "maxItems": 10000,
      "uniqueItems": true
    },
    "supersedes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9._-]{1,127}$"
      },
      "minItems": 0,
      "maxItems": 10000,
      "uniqueItems": true
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "from_scope": {
      "$ref": "common.schema.json#/$defs/scope"
    },
    "to_scope": {
      "$ref": "common.schema.json#/$defs/scope"
    }
  },
  "required": [
    "schema_version",
    "relation_id",
    "relation_type",
    "from_entity",
    "to_entity",
    "direction",
    "scenario",
    "artifact_class",
    "state",
    "conditions",
    "source_ids",
    "verified_at",
    "world_freshness_class",
    "review_status",
    "test_refs",
    "supersedes",
    "from_scope",
    "to_scope"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": ["UNKNOWN", "NOT_APPLICABLE"]
          }
        },
        "required": ["state"]
      },
      "then": {
        "not": {
          "required": ["value"],
          "properties": {
            "value": {}
          }
        }
      },
      "else": {
        "required": ["value"],
        "properties": {
          "value": {}
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "CONDITIONAL"
          }
        },
        "required": ["state"]
      },
      "then": {
        "required": ["conditions"],
        "properties": {
          "conditions": {
            "minItems": 1,
            "type": "array"
          }
        }
      }
    }
  ]
}
